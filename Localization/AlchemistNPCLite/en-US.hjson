					This effect is global for all players
					NON-CALAMITY BUFF POTION
					'''
			}

			TrapsPotion: {
				DisplayName: Trapper Potion
				Tooltip:
					'''
					Empoweres all traps
					NON-CALAMITY BUFF POTION
					'''
			}

			SingleUseCellphone: {
				Tooltip: Calls for Travelling Merchant. Can only be used during day time.
				DisplayName: Single Use Cellphone
			}
		}

		tier3PreHmOre: tier 3 Pre-hardmode ore
	}
