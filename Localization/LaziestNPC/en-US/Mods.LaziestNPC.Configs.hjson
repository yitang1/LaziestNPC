LNPCConfig: {
	DisplayName: Normal NPC Configs

	Headers: {
		LNPCs: "[i:GuideVoodooDoll] Mod NPCs"
		OtherNPCs: "[i:ClothierVoodooDoll] Other NPCs"
	}

	LNPCBossNPC: {
		Label: "[i:LaziestNPC/BossNPCIcon] Spawn NPC: Trial Officer"
		Tooltip:
			'''
			When enabled, the Trial Officer will spawn when conditions are met.
			This NPC sells: Vanilla and Mod Boss Treasure Bags, and Summon Items for Bosses, Enemies, and Events.

			Spawn Condition: At least [c/F2E635:6] town NPCs in the world.
			'''
	}

	LNPCPotionNPC: {
		Label: "[i:LaziestNPC/PotionNPCIcon] Spawn NPC: Elixir Brewer"
		Tooltip:
			'''
			When enabled, the Elixir Brewer will spawn when conditions are met.
			This NPC sells: Various Vanilla and Mod Potions and Food.

			Spawn Condition: At least [c/F2E635:5] town NPCs in the world.
			'''
	}

	LNPCMaterialNPC: {
		Label: "[i:LaziestNPC/MaterialNPCIcon] Spawn NPC: Astral Trader"
		Tooltip:
			'''
			When enabled, the Astral Trader will spawn when conditions are met.
			This NPC sells: Various Vanilla and Mod Materials.

			Spawn Condition: At least [c/F2E635:4] town NPCs in the world.
			'''
	}

	LNPCBuildNPC: {
		Label: "[i:LaziestNPC/BuildNPCIcon] Spawn NPC: Architect Scholar"
		Tooltip:
			'''
			When enabled, the Architect Scholar will spawn when conditions are met.
			This NPC sells: Various Vanilla and Mod Blocks, Crafting Stations, and Functional Furniture.

			Spawn Condition: At least [c/F2E635:3] town NPCs in the world.
			'''
	}

	LNPCNatureNPC: {
		Label: "[i:LaziestNPC/NatureNPCIcon] Spawn NPC: Flower Picker"
		Tooltip:
			'''
			When enabled, the Flower Picker will spawn when conditions are met.
			This NPC sells: Vanilla and Mod Critters, Fishing Catches, Crates, and Angler Quest Rewards.

			Spawn Condition: A [i:2290][c/F2E635:Bass] in your inventory.
			'''
	}

	LNPCOreNPC: {
		Label: "[i:LaziestNPC/OreNPCIcon] Spawn NPC: Trove Curator"
		Tooltip:
			'''
			When enabled, the Trove Curator will spawn when conditions are met.
			This NPC sells: Vanilla and Mod Ores and Accessories.

			Spawn Condition: [i:11][c/F2E635:Iron Ore] or [i:700][c/F2E635:Lead Ore] in your inventory.
			'''
	}

	ShowPortrait: {
		Label: "[i:PinWheel] NPC Dialogue Portraits"
		Tooltip:
			'''
			When enabled,
			the NPC dialogue interfaces of vanilla and this mod will display the corresponding NPC's portrait and name.
			'''
	}

	MobHealth: {
		Label: "[i:LifeCrystal] Increase Enemy HP"
		Tooltip:
			'''
			Applies globally at all times. The value is a multiplier.
			Final HP: Base HP multiplied by this value.
			Does not include critters and town NPCs.
			'''
	}

	LNPCInvincible: {
		Label: "[i:CombatBookVolumeTwo] Invincible All Town NPCs"
		Tooltip: Includes bound NPCs, the sleeping Angler, and the Tavernkeep.
	}

	LNPCCritterInvincible: {
		Label: "[i:Bunny] Invincible All Critters"
		Tooltip: Does not include the Prismatic Lacewing.
	}
}
