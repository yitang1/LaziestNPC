HadalStew: {
	DisplayName: Hadal Stew
	Tooltip:
		'''
		Only gives [PotionSick] seconds of Potion Sickness
		{$CommonItemTooltip.MajorStats}
		{$CommonItemTooltip.MinuteDuration}
		'''
}

TriumphPotion: {
	DisplayName: Triumph Potion
	Tooltip:
		'''
		Enemy contact damage is reduced
		the lower their health
		the more it is reduced (up to 15%)
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[c/8ADDFF:The greatest misjudgment in battle is to underestimate a dying rebel.]
		[c/8ADDFF:The people of the Ocean Kingdom were always calm, rarely showing panic even on the brink of death,]
		[c/8ADDFF:which led their enemies to mistake victory as easily within their grasp.]
		[c/8ADDFF:But this apparent frailty was precisely a deadly lure.]
		[c/8ADDFF:When the enemy realized their fatal final blow had failed to take effect,]
		[c/8ADDFF:they were about to face the surging wrath etched deep in their bloodline,]
		[c/8ADDFF:and the ensuing fatal counterattack.]
		'''
}

YharimsStimulants: {
	DisplayName: Yharim's Stimulants
	Tooltip:
		'''
		Gives decent buffs to ALL offensive and defensive stats:
		Increases damage for all types by 5%
		Increases critical strike chance for all types by 2%
		Increases melee speed by 7.5%, mining speed by 10%
		Increases minion knockback by 100%, movement speed by 7.5%
		Increases damage reduction by 4%, defense by 10
		Increases whip attack speed by 7.5%
		'''
}

CadencePotion: {
	DisplayName: Cadance Potion
	Tooltip:
		'''
		Gives the Cadance buff:
		Increases life regeneration by 2.5
		Increases maximum life by 25%
		Increases heart pickup range
		'''
}

RevivifyPotion: {
	DisplayName: Revivify Potion
	Tooltip:
		'''
		Causes enemy attacks to heal you for a fraction of their damage
		Healing amount is 1/15 of the damage taken
		'''
}

PenumbraPotion: {
	DisplayName: Penumbra Potion
	Tooltip:
		'''
		[CalamityMod]
		[Vanilla]
		'''
	CalamityText:
		'''
		Increases rogue stealth generation rate by 15% while moving or stationary
		Increases the stealth generation rate to 20% during a Solar Eclipse or when wearing a full set of Umbraphile armor
		'''
	VanillaText:
		'''
		Grants a 1% chance to dodge any attack
		This chance is increased to 5% during any event or boss active
		'''
}

ShatteringPotion: {
	DisplayName: Shattering Potion
	Tooltip:
		'''
		+8% critical strike chance
		[CalamityMod]
		[Vanilla]
		'''
	CalamityText:
		'''
		ALL types of attacks inflicted the Armor Crunch debuff
		Attacks have a 25% chance to inflict Armor Crunch for 6 seconds,
		a 37.5% chance for 4 seconds, and a 37.5% chance for 2 seconds
		'''
	VanillaText: Increases armor penetration by 40
}

TitanScalePotion: {
	DisplayName: Titan Scale Potion
	Tooltip:
		'''
		Increases knockback, defense by 5
		Increases damage reduction by 5%
		True melee strikes grant 25 defense and 10% damage reduction for 10 seconds
		'''
}

ProfanedRagePotion: {
	DisplayName: Profaned Rage Potion
	Tooltip:
		'''
		Increases critical strike chance by 12%
		Does NOT conflict with other potions
		'''
}

DraconicElixir: {
	DisplayName: Draconic Elixir
	Tooltip:
		'''
		Increases wing flight time by 20%
		Increases defense by 16
		[CalamityMod]
		[Vanilla]
		'''
	CalamityText:
		'''
		Silva invincibility heals you to half HP when triggered
		This effect has a 5-minute cooldown
		'''
	VanillaText:
		'''
		When wearing a full set of Solar, Vortex, Nebula, or Stardust armor:
		Taking fatal damage revives you in place and restores 50% of your max health
		This effect has a 5-minute cooldown
		'''
}
