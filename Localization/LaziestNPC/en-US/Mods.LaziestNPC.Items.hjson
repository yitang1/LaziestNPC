BossNPC: {
	DisplayName: Trial Officer
	Tooltip: Hello, Trialist. Anything you need for battle or adventure?
}

PotionNPC: {
	DisplayName: Elixir Brewer
	Tooltip: I just brewed a new potion, but I'm not sure how well it works... Would you like to try it?
}

MaterialNPC: {
	DisplayName: Astral Trader
	Tooltip: Hello there. Looking for any materials? Just give me the name.
}

BuildNPC: {
	DisplayName: Architect Scholar
	Tooltip: If you ever want to build something truly magnificent, be sure to let me know.
}

NatureNPC: {
	DisplayName: Flower Picker
	Tooltip: Heya! If you're ever feeling down, come play with me!
}

OreNPC: {
	DisplayName: Trove Curator
	Tooltip: Just look at all these shiny things. They're sure to lift your spirits.
}

