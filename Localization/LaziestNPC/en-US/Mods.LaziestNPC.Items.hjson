	Tooltip: ""
}

NatureNPCIcon: {
	DisplayName: Mod Conifg Icon
	Tooltip: ""
}

OreNPCIcon: {
	DisplayName: Mod Conifg Icon
	Tooltip: ""
}

GalacticaSingularity: {
	DisplayName: Galactica Singularity
	Tooltip: A shard of the cosmos
}

ThrownShimmerWater: {
	DisplayName: Shimmer Water
	Tooltip:
		'''
		Throw a bottle of Shimmer that passes through blocks and liquids
		Creatures struck by the bottle will undergo Shimmer transmutation
		[L]"Presenting the all-new 'Shimmer Shower' service:
		No lines, no running around,
		Just a direct hit to the face for instant transformation."
		'''
}

HJTanks: {
	DisplayName: Tank of the Past World
	Tooltip:
		'''
		Right click to open in your inventory
		Grants a random Tank of the Past Soul
		(Tank of the Past Soul: An item from the Homeward Journey Mod)
		[L]"Countless victims of the experiment
		have lent you their wrath and power.
		—physically."
		'''
}

HeartSacredRing: {
	DisplayName: Heart Sacred Ring
	Tooltip:
		'''
		Increases life regeneration by 1
		Upon taking damage:
		Greatly increases life regeneration to 10
		This bonus will gradually decay back to 1 over 5 seconds
		Cannot trigger again within 5 seconds
		Restores approximately 20 health (one heart) per trigger
		[ExtraText]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[L]"During the knighting ceremony of the [c/95E5DD:Red Heart Kingdom],
		the Queen personally bestows this ring upon the knights about to march to war.
		A ruby pulsing like a beating heart, set with golden wings of unyielding spirit and freedom.
		With tears in their eyes, the knights kiss it, shouting vows of triumph,
		and charge into enemy lines clad in glory.

		The war among the Four Kingdoms has raged for far too long.
		In truth, the Queen knows all too well that this supreme and glorious blessing—
		is destined to accompany its owner, forever resting in that scorched earth drenched in blood."
		'''
}

CallingSeaBottle: {
	DisplayName: Calling Sea Bottle
	Tooltip:
		'''
		Right click to open in your inventory
		Grants all vanilla common fish depending on world progression
		[c/FF3333:Warning: A massive amount of fish will instantly fill your inventory]
		[ExtraText]
		[c/808080:Transcendent Item]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[L]"The legendary [c/FF467B:God] of the [c/C5EEFF:Dream Sea]—[c/C5EEFF:The Dreamweaver Goddess], used this item before she became a God,
		back when she was still a Transcender.
		When the world-shattering [c/E9FFD1:Dream Sea Tide] event occurred,
		she raised this bottle and drew billions of Dream Sea creatures into it, quelling the disaster."
		'''
}

DreamSeaCrateBook: {
	DisplayName: Dream Sea Crate Book
	Tooltip:
		'''
		Right click to open in your inventory
		Grants all vanilla crates depending on world progression
		[c/FF3333:Warning: A massive amount of crates will instantly fill your inventory]
		[ExtraText]
		[c/808080:Transcendent Item]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[L]"On an island in the [c/C5EEFF:Dream Sea] lived a fisherman who spent his entire life compiling a Crate Catalog.
		Legend has it that after this fisherman passed away, he visited his children in a dream,
		claiming he had received the blessing of [c/C5EEFF:The Dreamweaver Goddess].
		The compendium was granted transcendent power, possessing inexhaustible wealth, and he warned them to hide it immediately.
		His children woke up in terror and hastily reported the matter to the local authorities.
		It is worth noting that after investigation and research by the [c/95E5DD:Star Clad Sanctum],
		it has been confirmed that this item is not a [c/FF467B:God-Dreaded Item], nor does it bear any trace of transcendent power.
		—merely an incomplete, worn-out Crate Catalog."
		'''
}

SunlightNet: {
	DisplayName: Sunlight Bug Net
	Tooltip:
		'''
		Right click to open in your inventory
		Grants all vanilla critters depending on world progression
		[c/FF3333:Warning: A massive amount of critters will instantly fill your inventory]
		[ExtraText]
		[c/808080:Transcendent Item]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[L]"A bug net specifically used by the Sunflower Tribe when purifying pollution.
		Although the Rafflesia Tribe scoffs at this,
		evidence shows that a passionate, cheerful mindset and a sun-basked body
		can indeed resist a portion of the terrifying illusion within the [c/C5EEFF:Mirage Garden].
		—Even if the [c/FF467B:God] departed without a word, we will still grow towards the sun and never give up."
		'''
}

PlatinumGoblet: {
	DisplayName: Platinum Goblet
	Tooltip:
		'''
		Right click to open in your inventory
		Grants vanilla boss trophies based on defeated bosses
		[ExtraText]
		[c/808080:Transcendent Item]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[L]"A relic forged of unknown metal, engraved with four geometric symbols of unknown meaning.

		Some archaeologists believe:
		These four symbols respectively correspond to the four most stringent laws of the universe:
		Order, Breakthrough, Perfection, and Denial.

		However, the local bumpkins who unearthed this item believe:
		'The wine that thing held always tasted a lot sweeter than any other cup!'

		It is worth noting that after investigation and research by the [c/95E5DD:Star Clad Sanctum],
		its appearance does not seem to be native to this world,
		but it has been confirmed that this item is not a [c/FF467B:God-Dreaded Item], nor does it bear any trace of transcendent power."
		'''
}

MysticRedJelly: {
	DisplayName: Mystic Red Jelly
	Tooltip:
		'''
		Summons Surly Slime
		Not consumable
		[L]"In the Jelly Museum of the [c/95E5DD:Slime Kingdom],
		there is a red top hat with a tag that reads:
		'The last jelly to willingly become a slime.'
		Hmph!"
		'''
}

MysticYellowJelly: {
	DisplayName: Mystic Yellow Jelly
	Tooltip:
		'''
		Summons Mystic Frog
		Not consumable
		[L]"One day,
		a frog claiming to be a traitor appeared in the [c/95E5DD:Froggy Kingdom].
		And thus, the story began..."
		'''
}

GentleSkull: {
	DisplayName: Gentle Skull
	Tooltip:
		'''
		Must be used at night
		Summons Skeletron
		Not consumable
		[L]"The Third Rule of the Skeleton Banquet:
		One must remain dignified at all times,
		even in death—especially in death!"
		'''
}

NoRootFlower: {
	DisplayName: NoRoot Flower
	Tooltip:
		'''
		Must be used in the Jungle 
		Summons Plantera
		Not consumable
		[L]"Its roots have long been severed by time,
		but its call can still pierce through the mud,
		awakening that Jungle Queen who refuses to wither."
		'''
}

ForbiddenPaper: {
	DisplayName: Forbidden Parchment
	Tooltip:
		'''
		Summons Lunatic Cultist
		Not consumable
		[ExtraText]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[c/88E6FF:When thy gaze falleth upon the pattern, a wrath most ancient and boundless shalt thou faintly sense.]
		[L]"[c/C5EEFF:Mr. Clhuthu] is the friendliest and most honorable [c/FF467B:God] I have ever met!
		HE grants us the sweet [c/D90000:Fountain of Life],
		bestows upon us the slumbering [c/D90000:Power of Fear],
		and even ignites our warm [c/D90000:Fire of Soul]!
		If anyone ever catches HIS gaze... wow—just get ready to be blessed~"
		'''
}

TheReturner: {
	DisplayName: Homeward Pendant
	Tooltip:
		'''
		Right click to open the panel. Basic functions:
		Toggle day and night
		Enable or disable rain and sandstorm
		Cancel various events in the game
		[ExtraText]
		[c/FF467B:God-Dreaded Item]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[c/88E6FF:Within doth lie information obscured; the faintly legible inscriptions read:]
		[c/88E6FF:"...alter Yin and Yang, invert Causality..." "...the Land of Homeward..." "...THEM..."]
		[L]"This item is suspected to originate from another realm or a higher dimension,
		boasting the immense power to command the clouds and rain, and call the sun and moon.
		So... how did this thing end up here?"
		'''
}

DoubleFishJade: {
	DisplayName: Double Fish Jade
	Tooltip:
		'''
		Upon contact with Shimmer or being re-crafted
		Its base sell value increases to 5 Gold
		Throwing it into Shimmer will split it in two
		[ExtraText]
		[c/FF467B:God-Dreaded Item]
		'''
	CommonTips: "[c/FBFBE0:Hold SHIFT to display more info]"
	ContentTexts:
		'''
		[c/88E6FF:Within the mirror a shadow doth dwell; beyond the shadow, a form doth spring.]
		[c/88E6FF:Devoid of falsehood, devoid of dreams; devoid of beginning, devoid of end...]
		[L]"Long long ago, there was a very greedy [c/FF467B:Player].
		After reading the item info of the [c/FF467B:Double Fish Jade], he had a bright idea and spoke:
		'Ignoring the price fluctuations caused by NPC happiness, theoretically speaking,
		1 item, thrown 9 times, 512 items, 25 Platinum; thrown 10 times, 1024 items, 50 Platinum;
		thrown 11 times, 2048 items, 100 Platinum; thrown 12 times, 4096 items, 200 Platinum...'
		So he immediately went crazy, repeatedly throwing the item into the Shimmer.
		Every time a pile of duplicates appeared, his eyes gleamed with gold,
		and he shouted: 'Hehehe, I'm rich, I'm rich! Money~ It's all money~ Oh yeah~'
		However, just as his words fell—
		his computer started smoking. (It later cost him a small fortune to fix it.)
		            —Excerpt from the children's book 'On the Terror of Exponential Powers'"
		'''
}
