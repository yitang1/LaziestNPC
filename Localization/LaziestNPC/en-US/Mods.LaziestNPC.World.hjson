Items: {
	TheReturner: {
		Title: Control Panel
		Day: Dawn
		Noon: Noon
		Night: Night
		Rain: Start Rain
		RainNo: Stop Rain
		CancelEvents: Cancel Events
		Close: Close
		SandstormOn: The Sandstorm has begun.
		SandstormOff: The Sandstorm has stopped.
		RainOn: It begins to rain.
		RainOff: The rain has stopped.
		DayOn: Time set to dawn.
		NoonOn: Time set to noon.
		NightOn: Time set to night.
		CancelEventsOn: All events have been terminated. Calm has returned to the world.
		EventsNone: There are no active events to terminate.
		Reborn:
			'''
			You have refused the pilgrimage to the Land of Homeward! Instantly revived at full health!
			(For unknown reasons, you have accidentally triggered the hidden power of the God-Dreaded Item — the Homeward Pendant.)
			'''
	}
}
