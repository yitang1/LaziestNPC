LNPCConfig: {
	DisplayName: LaziestNPC 模组配置

	Headers: {
		LNPCs: "[i:GuideVoodooDoll] 模组NPC相关"
		OtherNPCs: "[i:ClothierVoodooDoll] 其他NPC相关"
	}

	LNPCBossNPC: {
		Label: "[i:LaziestNPC/BossNPCIcon] 生成NPC：试炼官"
		Tooltip:
			'''
			启用后，试炼官会在满足条件时生成
			此NPC售卖：原版和模组的Boss宝藏袋，Boss、敌怪和事件的召唤物品

			生成条件：世界中至少有[c/F2E635:6]名城镇NPC存在
			'''
	}

	LNPCPotionNPC: {
		Label: "[i:LaziestNPC/PotionNPCIcon] 生成NPC：酿灵师"
		Tooltip:
			'''
			启用后，酿灵师会在满足条件时生成
			此NPC售卖：原版和模组的各种药水

			生成条件：世界中至少有[c/F2E635:5]名城镇NPC存在
			'''
	}

	LNPCMaterialNPC: {
		Label: "[i:LaziestNPC/MaterialNPCIcon] 生成NPC：星海商人"
		Tooltip:
			'''
			启用后，星海商人会在满足条件时生成
			此NPC售卖：原版和模组的各种材料

			生成条件：世界中至少有[c/F2E635:4]名城镇NPC存在
			'''
	}

	LNPCBuildNPC: {
		Label: "[i:LaziestNPC/BuildNPCIcon] 生成NPC：机枢学者"
		Tooltip:
			'''
			启用后，机枢学者会在满足条件时生成
			此NPC售卖：原版和模组的物块和制作站

			生成条件：世界中至少有[c/F2E635:3]名城镇NPC存在
			'''
	}

	LNPCNatureNPC: {
		Label: "[i:LaziestNPC/NatureNPCIcon] 生成NPC：采花匠"
		Tooltip:
			'''
			启用后，采花匠会在满足条件时生成
			此NPC售卖：原版和模组的动植物、渔获和钓鱼任务奖励

			生成条件：物品栏中有[i:2290][c/F2E635:鲈鱼]
			'''
	}

	LNPCOreNPC: {
		Label: "[i:LaziestNPC/OreNPCIcon] 生成NPC：收藏家"
		Tooltip:
			'''
			启用后，收藏家会在满足条件时生成
			此NPC售卖：原版和模组的矿物和配饰

			生成条件：物品栏中有[i:11][c/F2E635:铁矿]或[i:700][c/F2E635:铅矿]
			'''
	}

	LNPCInvincible: {
		Label: "[i:CombatBookVolumeTwo] 所有城镇NPC无敌"
		Tooltip: 包括受缚NPC、躺着睡觉的渔夫和酒馆老板
	}

	LNPCCritterInvincible: {
		Label: "[i:Bunny] 所有小动物无敌"
		Tooltip: 不包括七彩草蛉
	}

	ShowPortrait: {
		Label: "[i:PinWheel] NPC对话肖像图"
		Tooltip:
			'''
			启用后，
			本Mod和原版的NPC对话界面
			会显示对应NPC的肖像图和名字
			'''
	}
}
