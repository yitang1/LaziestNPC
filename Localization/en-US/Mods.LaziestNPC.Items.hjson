}

GalacticaSingularity: {
	DisplayName: 星系异石
	Tooltip: 广阔宇宙的结晶
}

ThrownShimmerWater: {
	DisplayName: 微光水瓶
	Tooltip:
		'''
		投掷微光水瓶，能够穿过物块和液体
		被水瓶击中的生物会进行微光转化
		[L]“全新‘微光淋浴’服务，
		无需排队，无需跑腿，
		原地砸脸，即刻变形。”
		'''
}

HeartSacredRing: {
	DisplayName: 红心圣戒
	Tooltip:
		'''
		增加1点生命再生速度
		受伤时，大幅提升至10点生命再生速度
		之后，在5秒内会逐渐衰减至1点
		[ExtraText]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[L]“在[c/95E5DD:红心王国]的授勋仪式上，女王会将这枚戒指亲自赐予即将踏上战场的骑士。
		心脏般跳动的红宝石，镶嵌着不屈与自由的金色双翼。
		骑士们饱含热泪亲吻它，高呼凯旋的誓言，带着满身荣光冲向敌阵。

		四大王国的战火燃烧了太久。
		其实女王心里很清楚，这份无上而光荣的祝福——
		注定要伴随它的主人，永远留在那片被鲜血浸透的焦土之上。”
		'''
}

CallingSeaBottle: {
	DisplayName: 唤海瓶
	Tooltip:
		'''
		在物品栏中右键以打开
		根据当前世界所处的时期
		会获得原版所有的普通鱼
		[c/FF3333:警告：大量的鱼会瞬间塞满你的物品栏]
		[ExtraText]
		[c/808080:超凡之物]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[L]“[c/C5EEFF:梦境之海]传说中的[c/FF467B:神灵]——[c/C5EEFF:织梦女神]在成神前，
		曾经还是作为超凡者时，使用过的物品。
		在毁天灭地的[c/E9FFD1:梦之潮汐]事件发生时，
		她举瓶，将亿万梦海生物吸纳其中，平息了灾难。”
		'''
}

DreamSeaCrateBook: {
	DisplayName: 梦海宝匣大全
	Tooltip:
		'''
		在物品栏中右键以打开
		根据当前世界所处的时期
		会获得原版和模组的钓鱼宝匣
		[c/FF3333:警告：大量宝匣会瞬间塞满你的物品栏]
		[ExtraText]
		[c/808080:超凡之物]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[L]“[c/C5EEFF:梦境之海]的一座海岛上居住的某位渔民，
		其耗费了毕生精力整理的宝匣图鉴。
		传闻这位渔民去世后，给自己的孩子们托了个梦，
		梦中他自称受到了[c/C5EEFF:织梦女神]的祝福，
		那本宝匣图鉴被赐予了超凡之力，
		拥有了取之不尽用之不竭的财富，告诫需火速藏匿。
		他的孩子们醒来后惊恐不已，慌忙上报当地政府。
		值得注意的是，经过[c/95E5DD:披星殿堂]的考证和研究，
		已确定此物不属于[c/FF467B:神惧之物]，也没有任何超凡之力的痕迹。
		——只是一本并不齐全的、破旧的宝匣图鉴而已。”
		'''
}

SunlightNet: {
	DisplayName: 阳光捕虫网
	Tooltip:
		'''
		在物品栏中右键以打开
		根据当前世界所处的时期
		会获得原版所有的小动物
		[c/FF3333:警告：大量小动物会瞬间塞满你的物品栏]
		[ExtraText]
		[c/808080:超凡之物]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[L]“向日葵族的人在祛除污染时，专门使用的捕虫网。
		尽管大王花族的人对此嗤之以鼻，
		但事实证明，热情开朗的心态和沐浴阳光的身体，
		的确能够抵御[c/C5EEFF:幻境花园]中，一部分恐怖的幻觉。
		——即使[c/FF467B:神灵]不告而别，我们依然向阳而生，永不言弃。”
		'''
}

PlatinumGoblet: {
	DisplayName: 白金酒杯
	Tooltip:
		'''
		在物品栏中右键以打开
		根据你击败过的原版Boss
		会获得对应的Boss纪念章
		[ExtraText]
		[c/808080:超凡之物]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[L]“未知金属铸就的遗物，雕刻着四个不知含义的几何符号。
		
		有考古学家认为：
		这四个符号分别对应着宇宙中四种最严苛的法则：秩序、突破、圆满与否定。

		而发掘此物的当地土著认为：
		‘那玩意儿装过的葡萄酒，喝起来总是比别的杯子要甜不少！’

		值得注意的是，经过[c/95E5DD:披星殿堂]的考证和研究，尽管外观并不像是本世界产物，
		但已确定此物不属于[c/FF467B:神惧之物]，也没有任何超凡之力的痕迹。”
		'''
}

MysticRedJelly: {
	DisplayName: 神奇红色果冻
	Tooltip:
		'''
		召唤暴躁史莱姆
		不消耗
		[L]“[c/95E5DD:史莱姆王国]的果冻博物馆里，
		有一顶红色礼帽，标签上写着：
		‘最后一位自愿变成史莱姆的果冻。’
		哼叽！”
		'''
}

MysticYellowJelly: {
	DisplayName: 神奇黄色果冻
	Tooltip:
		'''
		召唤神秘青蛙
		不消耗
		[L]“有一天，[c/95E5DD:蛙蛙王国]出现了一个
		自称为叛徒的蛙。
		随后，故事便开始了......”
		'''
}

GentleSkull: {
	DisplayName: 绅士遗骨
	Tooltip:
		'''
		在夜晚使用
		召唤骷髅王
		不消耗
		[L]“骷髅宴会守则之三：
		任何时候都要保持体面，
		哪怕是死后——尤其是死后！”
		'''
}

NoRootFlower: {
	DisplayName: 无根之花
	Tooltip:
		'''
		在丛林中使用
		召唤世纪之花
		不消耗
		[L]“它的根须早已被时间斩断，
		但它的呼唤仍能穿透泥层，
		唤醒那位拒绝凋零的丛林女王。”
		'''
}

ForbiddenPaper: {
	DisplayName: 禁忌羊皮纸
	Tooltip:
		'''
		召唤拜月教邪教徒
		不消耗
		[ExtraText]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[c/88E6FF:直视图案时，会隐约感受到一股滔天的恨意。]
		[L]“[c/C5EEFF:克鲁苏先生]是我见过最友好、最值得尊敬的[c/FF467B:神灵]！
		祂给予我们甘甜的[c/D90000:生命之源]，
		赐予我们沉睡的[c/D90000:恐惧之力]，
		甚至还点燃我们温暖的[c/D90000:灵魂之火]！
		要是谁被祂注视了......哇——就等着享福吧~”
		'''
}

TheReturner: {
	DisplayName: 归乡者吊坠
	Tooltip:
		'''
		右键开启面板，基础功能：
		切换白天和黑夜
		启用或禁用下雨和沙尘暴
		终止游戏中的各种事件
		[ExtraText]
		[c/FF467B:神惧之物]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[c/88E6FF:内含模糊信息，依稀可见的字样有：]
		[c/88E6FF:“...易阴阳、倒因果” “归乡之地...” “祂们...”]
		[L]“此物疑似来自异界或更高维度，
		拥有翻云雨、唤日月之伟力。
		所以这东西…怎么会在这个地方？”
		'''
}

DoubleFishJade: {
	DisplayName: 双鱼玉佩
	Tooltip:
		'''
		与微光接触或重新制作后
		基础售卖价值会提升至15金
		扔进微光中会被一分为二
		[c/FF3333:警告：适可而止]
		[ExtraText]
		[c/FF467B:神惧之物]
		'''
	CommonTips: "[c/FBFBE0:长按Shift键以显示额外信息]"
	ContentTexts:
		'''
		[c/88E6FF:镜中有影，影外生形，无妄无梦，无始无终...]
		[L]“在很久很久以前，有一个非常贪心的[c/FF467B:玩家]，
		他在阅读完[c/FF467B:双鱼玉佩]的物品信息后，灵机一动，开口道：
		忽略NPC快乐度带来的售价浮动，理论上来算的话，
		1个物品，扔8次，256个，38铂金；扔9次，512个，76铂金；
		扔10次，1024个，153铂金；扔11次，2048个，307铂金...
		于是他立马疯狂地将这个物品反反复复扔到微光里，
		每次一堆复制品出来后，他都两眼冒金光，
		然后大喊：嘿嘿嘿发财了发财了！钱啊~这全都是钱啊~哦耶~
		然而，他话音刚落——
		他的电脑就冒烟了。(后来花了一万多块钱才修好)
		       ——节选自儿童读物《论指数幂的恐怖之处》”
		'''
}
