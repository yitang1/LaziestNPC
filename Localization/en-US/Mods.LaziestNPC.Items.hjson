MysticRedJelly: {
	DisplayName: 神奇红色果冻
	Tooltip:
		'''
		召唤暴躁史莱姆
		不消耗
		[c/FBFBE0:“史莱姆王国的果冻博物馆里，]
		[c/FBFBE0:有一顶红色礼帽，标签上写着：]
		[c/FBFBE0:‘最后一位自愿变成史莱姆的果冻。’]
		[c/FBFBE0:哼叽！”]
		'''
}

MysticYellowJelly: {
	DisplayName: 神奇黄色果冻
	Tooltip:
		'''
		召唤神秘青蛙
		不消耗
		[c/FBFBE0:“有一天，蛙蛙王国出现了一个]
		[c/FBFBE0:自称为叛徒的蛙。]
		[c/FBFBE0:随后，故事便开始了......”]
		'''
}

GentleSkull: {
	DisplayName: 绅士遗骨
	Tooltip:
		'''
		在夜晚使用
		召唤骷髅王
		不消耗
		[c/FBFBE0:“骷髅宴会守则之三：]
		[c/FBFBE0:任何时候都要保持体面，”]
		[c/FBFBE0:哪怕是死后——尤其是死后！”]
		'''
}

NoRootFlower: {
	DisplayName: 无根之花
	Tooltip:
		'''
		在丛林中使用
		召唤世纪之花
		不消耗
		[c/FBFBE0:“它的根须早已被时间斩断，]
		[c/FBFBE0:但它的呼唤仍能穿透泥层，]
		[c/FBFBE0:唤醒那位拒绝凋零的丛林女王。”]
		'''
}

ForbiddenPaper: {
	DisplayName: 禁忌羊皮纸
	Tooltip:
		'''
		召唤拜月教邪教徒
		不消耗
		[ExtraText]
		'''
	CommonTips: "[c/FBFBE0:长按“左Shift”键以显示额外信息]"
	ContentTexts:
		'''
		[c/88E6FF:直视图案时，会感受到一股滔天的恨意。]
		[c/FBFBE0:“克鲁苏先生是我见过最友好、最值得尊敬的神灵！]
		[c/FBFBE0:祂给予我们甘甜的][c/FF3333:生命之源][c/FBFBE0:，]
		[c/FBFBE0:赐予我们沉睡的][c/FF3333:恐惧之力][c/FBFBE0:，]
		[c/FBFBE0:甚至还点燃我们温暖的][c/FF3333:灵魂之火][c/FBFBE0:！]
		[c/FBFBE0:要是谁被祂注视了......哇——就等着享福吧~”]
		'''
}

TheReturner: {
	DisplayName: 归乡者项链
	Tooltip:
		'''
		右键开启面板，基础功能：
		切换白天和黑夜
		启用或禁用下雨或沙尘暴
		终止游戏中的各种事件
		[ExtraText]
		[c/FF467B:【神惧之物】]
		'''
	CommonTips: "[c/FBFBE0:长按“左Shift”键以显示额外信息]"
	ContentTexts:
		'''
		[c/88E6FF:内含模糊信息：“易阴阳”、“倒因果”...]
		[c/FBFBE0:“此物疑似来自异界或更高维度，]
		[c/FBFBE0:拥有翻云雨、唤日月之伟力。]
		[c/FBFBE0:所以这东西…怎么会在这个地方？”]
		'''
}

DoubleFishJade: {
	DisplayName: 双鱼玉佩
	Tooltip:
		'''
		与微光接触或重新制作后
		基础售卖价值会提升至25金
		扔进微光中会被一分为二
		[c/FF3333:警告：适可而止]
		[ExtraText]
		[c/FF467B:【神惧之物】]
		'''
	CommonTips: "[c/FBFBE0:长按“左Shift”键以显示额外信息]"
	ContentTexts:
		'''
		[c/8ADDFF:镜中有影，影外生形，无妄无梦，无始无终...]

		[c/FBFBE0:“在很久很久以前，有一个非常贪心的玩家，]
		[c/FBFBE0:他在阅读完双鱼玉佩的信息介绍后，灵机一动，开口道：]
		[c/FBFBE0:忽略NPC快乐度带来的售价浮动，理论上来算的话，]
		[c/FBFBE0:扔8次，256个，64铂金；]
		[c/FBFBE0:扔9次，512个，128铂金；]
		[c/FBFBE0:扔10次，1024个，256铂金；]
		[c/FBFBE0:扔11次，2048个，512铂金...]
		[c/FBFBE0:于是他立马疯狂地将这个物品反反复复扔到微光里，]
		[c/FBFBE0:每次一堆复制品出来后，他都两眼冒金光，]
		[c/FBFBE0:然后大喊：发财了发财了！钱啊~这全都是钱啊~哦耶哦耶~]
		[c/FBFBE0:然而，他话音刚落——]
		[c/FBFBE0:他的电脑就冒烟了。(后来花了一万多块钱才修好)]
		[c/FBFBE0:      ——节选自文章《论指数幂的恐怖之处》”]
		'''
}
