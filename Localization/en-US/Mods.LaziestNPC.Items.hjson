BossNPC: {
	DisplayName: 试炼官
	Tooltip: “你好，试炼者。有什么关于战斗和冒险方面的需要吗？”
}

PotionNPC: {
	DisplayName: 酿灵师
	Tooltip: “我新调了一瓶药，但不知道效果怎么样……要试试吗？”
}

MaterialNPC: {
	DisplayName: 星海商人
	Tooltip: “你好啊，在找什么素材？告诉我名字就行。”
}

BuildNPC: {
	DisplayName: 机枢学者
	Tooltip: “如果你哪天想盖一座真正宏伟的建筑，记得叫上我。”
}

NatureNPC: {
	DisplayName: 采花匠
	Tooltip: “如果你不开心，就来找我玩吧。”
}

OreNPC: {
	DisplayName: 收藏家
	Tooltip: “看看我这里这些亮晶晶的东西，能让人心情变好。”
}

