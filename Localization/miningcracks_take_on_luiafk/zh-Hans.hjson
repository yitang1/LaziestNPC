Mods: {
	miningcracks_take_on_luiafk: {
		Conditions: {
			Master: Luiafk: 仅供大师模式
			Expert: Luiafk: 仅供专家模式及以上
		}

		NPCs: {
			Deeps: {
				DisplayName: 升级版假人

				TownNPCMood: {
					Content: ...
					NoHome: ...
					FarFromHome: ...
					LoveSpace: ...
					DislikeCrowded: ...
					HateCrowded: ...
					LikeNPC_Princess: ...
					Princess_LovesNPC: ...
				}
			}

			MobileMerchant: {
				DisplayName: 仙灵商人

				TownNPCMood: {
					Content: 嘿，很高兴和你聊天。OwO
					NoHome: 我不理解想要有一个家的冲动，我只是一个静止不动的飞行商人……
					FarFromHome: 哈？不，我不需要家。
					LoveSpace: 我和朋友们能有这么大的空间，谢谢你。OvO
					DislikeCrowded: 这里是在举行派对吗？附近的人太多了。
					HateCrowded: 这里的人太多了，请让他们走开。
					LikeNPC_Princess: 我喜欢{NPCName}。
					Princess_LovesNPC: 我喜欢{NPCName}。
				}

				Chat: 快点，我不能呆太久……
			}

			SkeletonMerchant: {
				DisplayName: 骷髅商人

				TownNPCMood: {
					Content: 谢谢你还没杀我，非常感谢。
					NoHome: 我也想有一个家，你应该明白我的意思。:(
					LoveSpace: 周围这么大的空间非常适合让我来练习悠悠球和扔骨头……当然，我不会打到别人的眼睛。
					FarFromHome: 你愿意帮我找到回家的路吗？你知道的，作为一具骷髅，我看不到自己要去哪里……
					DislikeCrowded: 这里有大型派对吗？人太多了……
					HateCrowded: 哇，我周围的人太多了……我讨厌这样。
					LikeBiome: 另外，我很喜欢森林，它和地下不一样。可以让我呼吸一次新鲜空气！
					LoveBiome: 此外，我真的很喜欢地下。更让我有家的感觉！
					DislikeBiome: 还有一个问题：我为什么会在这里？！
					HateBiome: 在被{BiomeName}的敌怪攻击的时候，会很难去保持从容和体面。
					LikeNPC: 我和{NPCName}聊过，他是个很酷的人！
					LoveNPC: 我和{NPCName}交谈过……他喜欢炸东西，我也是，我们本该在一起的！
					HateNPC: 嗯……朋友，有个叫{NPCName}的女孩想要净化我……我不喜欢那样，她想在我身上做实验……救命！
					LikeNPC_Princess: 我喜欢{NPCName}。
					Princess_LovesNPC: 我喜欢{NPCName}。
				}

				Census.SpawnCondition: 击败任意50个骷髅
			}

			TravellingMerchant: {
				DisplayName: 旅商

				TownNPCMood: {
					Content: 嘿！你今天在找什么新奇货物吗？
					NoHome: 我也想有一个家，你应该懂我的意思。:(
					LoveSpace: 啊哈，有这么大的空间！此刻，我可以考虑一下我的生意了！
					FarFromHome: 帮帮我！我找不到回家的路了。拜托，请带我回去。
					DislikeCrowded: 这里的顾客似乎有点太多了，嗯？
					HateCrowded: 好吧，我的存货有限……我不能给你们所有人，给我一些空间……
					LikeBiome: 是的，沙漠很酷。我喜欢这里的风景和……哦，一位顾客！
					LoveBiome: 啊哈，森林……放松和平静的居住场所，最重要的是还有很多顾客！
					HateBiome: 另外，我有个问题……你想让我在这里做什么……说真的，这里太危险了，没人会买我的东西。我真的讨厌这个地方。
					LikeNPC: "{NPCName}有一个极好的商人之魂，我喜欢！"
					LoveNPC: 哦，{NPCName}在这里……哦不，我又脸红了吗？
					HateNPC: 求你了，能让我不跟{NPCName}住在同一个地方吗？他正在偷我的毕生积蓄……
					LikeNPC_Princess: 我喜欢{NPCName}。
					Princess_LovesNPC: 我喜欢{NPCName}。
				}

				Census.SpawnCondition: 身上有50个金币
			}

			TargetDummy: {
				// DisplayName: Target Dummy

				TownNPCMood: {
					// Content: I am content.
					// NoHome: I hate not having a home.
					// FarFromHome: I am too far from home.
					// LoveSpace: I love having so much space.
					// DislikeCrowded: I dislike how crowded I am.
					// HateCrowded: I hate how crowded I am.
					// LikeNPC_Princess: I like {NPCName}.
					// Princess_LovesNPC: I like {NPCName}.
				}
			}
		}

		Buffs: {
