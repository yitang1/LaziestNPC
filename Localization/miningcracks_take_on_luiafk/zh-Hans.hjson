			ArenaBuilder: {
				DisplayName: 战斗平台搭建器
				Tooltip:
					'''
					搭建一个大约200格宽的平台
					方向取决于玩家朝向
					右键选择平台材料和附加功能
					背包若有沥青平台则会优先选择
					开启篝火按钮会自动放置篝火
					会自动放置泡泡来容纳蜂蜜
					开启灯光按钮会沿平台放置照明方块
					不会破坏沿路物块
					'''
			}

			Arena: {
				// DisplayName: Arena
				// Tooltip: ""
			}

			FishingBiomeBuilder: {
				DisplayName: 钓鱼环境搭建器
				Tooltip:
					'''
					搭建一个钓鱼用的生物群落
					每次生成一个22x18的实心物块区域
					方向取决于玩家朝向
					右键可打开配置选项
					选择黑曜石将在丛林和蘑菇环境放置对应背景墙
					选择木材/石块作为区块外围的材料
					切换灯以选择是否点亮提供照明
					珍珠石/粉冰雪块只能在困难模式中使用
					'''
			}

			FishingBuilder: {
				DisplayName: 水池搭建器
				Tooltip:
					'''
					用于建造钓鱼池或放置/移除液体
					每次生成一个22x18的空间
					方向取决于玩家朝向
					右键可打开配置选项
					当钓鱼池功能关闭时，其工作方式类似于终极液体控制器
					当钓鱼池功能开启时，能使用选择的液体创建一个钓鱼池
					钓鱼池功能开启时，如果你选择海绵，将创建一个空区域
					选择黑曜石图标来决定是否放置背景墙
					'''
			}

			GroundFiller: {
				DisplayName: 土魔杖 2.0
				Tooltip:
					'''
					右键可更改模式
					模式1:平整并填充你脚下的地面，300格宽，50格深
					模式2:在模式1基础上，同时清除上方50格物块
					模式3:同样适用于地牢、神庙和地下沙漠，留下背景墙
					模组的物块将被原版物块取代
					'''
			}

			Hellevator: {
				DisplayName: 地狱直通车
				Tooltip:
					'''
					搭建一个直通地狱的通道
					通道宽7格(内部5格宽)
					右键可打开配置选项
					开启灯光按钮会点亮提供照明
					背包中有无限绳索时才会放置绳索
					遇到丛林神庙时会停止
					'''
			}

			PrisonBuilder: {
				DisplayName: 监狱搭建器
				Tooltip:
					'''
					搭建一个NPC监狱
					方向取决于玩家朝向
					右键可打开配置选项
					开启灯光按钮会点亮提供照明
					(点亮与否都视为合格房屋)
					'''
			}

			SkyPlatformBuilder: {
				DisplayName: 世界平台搭建器
				Tooltip:
					'''
					搭建一个世界长度的平台
					右键可打开配置选项
					开启灯光按钮会点亮提供照明
					不会破坏沿路物块
					背包若有沥青平台则会优先选择
					'''
			}

			SubAndSky: {
				DisplayName: 铁轨/平台搭建器
				Tooltip:
					'''
					右键可打开配置选项
					开启灯光按钮会点亮提供照明
					平台搭建器模式下：
					选择黑曜石图标来决定是否放置黑曜石平台
					如果库存中有无限沥青平台，则会优先选择
					铁轨搭建器模式下：
					选择黑曜石图标来决定轨道是否放置墙壁
					会破坏沿路物块
					石巨人被击败后可以穿过神庙
					'''
			}

			SubwayBuilder: {
				DisplayName: 铁轨搭建器
				Tooltip:
					'''
					搭建一条铁轨
					右键可打开配置选项
					开启灯光按钮会点亮提供照明
					石巨人被击败后可以穿过神庙
					'''
			}

			InstantMoonLord: {
				DisplayName: 瞬间月亮领主召唤物
				Tooltip: 跳过召唤过程中的等待
			}

			NoAltarGolem: {
				DisplayName: 石巨人召唤物
				Tooltip:
					'''
					不需要丛林蜥蜴祭坛就能召唤石巨人
					只有在石巨人被击败后才能用
					'''
			}

			NoFishDuke: {
				DisplayName: 猪龙鱼公爵召唤物
