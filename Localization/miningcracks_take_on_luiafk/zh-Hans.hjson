		Configs: {
			LuiAFKConfig: {
				DisplayName: LuiAFK 服务端配置

				Headers: {
					Harvester: 收割机配置
					Potions: 药水&增益配置
					Accessories: 配饰选项
					NPC: NPC选项
					Tools: 工具&杂项选项
					Fishing: 钓竿配置
					Ammo: 弹药选项
				}

				harvesterAvailability: {
					Label: 收割机
					Tooltip:
						'''
						在何种难度下可使用收割机
						选项：禁用，普通+，专家+ 和 大师+
						默认为专家+
						'''
				}

				potionsEnable: {
					Label: 无限药水
					Tooltip:
						'''
						是否启用无限药水物品的合成配方
						无限药水物品在背包中时是否会获得增益效果
						'''
				}

				vanillaPotionsEnable: {
					Label: 自动使用原版药水
					Tooltip:
						'''
						当堆叠药水数量大于等于30时是否获得永久增益
						选项：禁用，总是启用 和 1个无限药水存在时启用
						'''
				}

				PaperAmountForScrollCrafting: {
					Label: 更改纸张数量
					Tooltip:
						'''
						制作卷轴所需要的纸张数量
						0禁用制作配方中的纸张
						默认值为5
						'''
				}

				ultimateBattlerTimer: {
					Label: 极限战争倒计时
					Tooltip:
						'''
						极限战争增益在激活前是否有5秒的倒计时
						选项：禁用，启用前 和 启用后
						'''
				}

				manaEnable: {
					Label: 无限魔力 [i:{0}] [i:{1}] [i:{2}] [i:{3}] [i:{4}] [i:{5}]
					Tooltip:
						'''
						是否启用无限魔力
						(物品为配饰，放在背包中不会生效)
						'''
				}

				superTools: {
					Label: 挖掘饰品 [i:{0}] [i:{1}] [i:{2}]
					Tooltip:
						'''
						是否能够获得并使用挖掘加速，工具时间和家园改造
						(物品为配饰，放在背包中不会生效)
						'''
				}

				boneEnable: {
					Label: 生成城镇NPC 骷髅商人
					Tooltip:
						'''
						是否生成城镇NPC骷髅商人
						关闭时不会移除已经生成的骷髅商人
						'''
				}

				merchantEnable: {
					Label: 生成城镇NPC 旅商
					Tooltip:
						'''
						是否生成城镇NPC旅商
						关闭时不会移除已经生成的旅商
						'''
				}

				builderEnable: {
					Label: 生成搭建器和魔棒工具 [i:{0}]
					Tooltip: 是否能够获得并使用任何的搭建器/魔棒工具
				}

				worldRemoverEnable: {
					Label: 筋斗云 [i:{0}]
					Tooltip: 是否能够获得并使用改进型钻头控制装置(筋斗云)
				}

				moneyEnable: {
					Label: 钱币收集器 [i:{0}]
					Tooltip: 是否能够获得并使用钱币收集器
				}

				killerEnable: {
					Label: 无限商人杀手 [i:{0}]
					Tooltip: 是否能够获得并使用无限商人杀手
				}

				magnetEnable: {
					Label: 战利品磁铁 [i:{0}]
					Tooltip: 是否能够获得并使用战利品磁铁
				}

				neededQuests: {
					Label: 额外钓鱼线
					Tooltip:
						'''
						获得每个额外的钓鱼线需要完成多少钓鱼任务
						数值范围在0到100之间
						0为禁用
						默认为5个任务额外增加一根钓鱼线
						'''
				}

				rangerAmmo: {
					Label: 无限弹药
					Tooltip:
						'''
						远程弹药不消耗所需的数量
						数值范围在0到10000之间
						0禁用
						默认为3996
						'''
				}

				thrownAmmo: {
					Label: 无限投掷武器
					Tooltip:
						'''
						投掷武器不消耗所需的数量
						数值范围在0到10000之间
						0禁用
						默认为999
						'''
				}
			}

			SettingsConfigClient: {
				DisplayName: LuiAFK 客户端配置
				Headers.Different_Enabling/Disabling_Options: 不同的启用/禁用选项

