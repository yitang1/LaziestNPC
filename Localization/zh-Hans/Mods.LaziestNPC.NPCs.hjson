	button1: 原版药水
	button2: 模组药水
}

MaterialNPC: {
	DisplayName: 星海商人
	Name.MaterialNPC: ""
	PortraitName: 星海商人

	Chat: {
		Normal1: 如果累了，就抬头看看星空吧。虽然它们看起来都差不多，但这并不妨碍我们借着星空放空大脑，天马行空地胡思乱想一阵，不是吗？
		Normal2: 你好啊，在找什么素材？告诉我名字就行。就算现在没有，下次航行我也一定会替你留意。
		Normal3: 如果有一天你离开这个世界，去别的地方旅行和冒险，记得报我的名字。沿途有些港口会给老主顾打折，怎么，你不信？哼~在航海圈子里，我可是很有名的。
		Normal4: 船长？我？算是吧。不过我更喜欢别人叫我星海商人。船长听起来太正经、太有架子了，不适合我这种目标是星辰大海的人~
		Normal5: 你可能在其他地方听说过我的事迹，说我是什么横渡星海，穿梭于各个世界的人？哈哈，我可以负责任地告诉你，那都是谣言，我只是个普普通通的航海商而已呀。
	}

	TownNPCMood: {
